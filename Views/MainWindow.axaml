<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ps4PkgSender.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="using:Ps4PkgSender.Models.Converters"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Ps4PkgSender.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="PS4 PKG Sender"
        Background="White">
    <Window.Resources>
        <conv:BytesToBitmapConverter x:Key="bytesToImage"></conv:BytesToBitmapConverter>
    </Window.Resources>
    <Grid RowDefinitions="*, auto, auto" RowSpacing="10">
        <ListBox Grid.Row="0" ItemsSource="{Binding Pkgs}" Margin="10 10 10 0" Background="Gray">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" BorderBrush="Black" BorderThickness="3" CornerRadius="7" Padding="7" Margin="0 0 0 7" ClipToBounds="True">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding ImageBytes, Converter={StaticResource bytesToImage}}" Width="150" Height="150"></Image>
                            <StackPanel Orientation="Vertical" Margin="20 0 0 0" VerticalAlignment="Center">
                                <TextBlock>
                                    <Run Text="Title: " FontWeight="Bold"/>
                                    <Run Text="{Binding Title}"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Title ID: " FontWeight="Bold"/>
                                    <Run Text="{Binding TitleID}"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Type: " FontWeight="Bold"/>
                                    <Run Text="{Binding Type}"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Version: " FontWeight="Bold"/>
                                    <Run Text="{Binding AppVer}"/>
                                </TextBlock>
                                <TextBlock TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                    <Run Text="File Name: " FontWeight="Bold"/>
                                    <Run Text="{Binding FileName}"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Size: " FontWeight="Bold"/>
                                    <Run Text="{Binding SizeGB, StringFormat={}{0:F2} GB}"/>
                                </TextBlock>
                                <Button Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RemovePKGCommand}"
                                        CommandParameter="{Binding}"
                                        Background="Red"
                                        Margin="0 10 0 0"
                                        IsVisible="{Binding !IsTransferring}">Remove PKG
                                        </Button>
                                <ProgressBar
                                    Grid.Column="0" 
                                    Foreground="Green"
                                    Minimum="0"
                                    Maximum="{Binding SizeGB}"
                                    Value="{Binding TransferredSizeGB}"
                                    ShowProgressText="True"
                                    ProgressTextFormat="{}{0:F2} GB / {3:F2} GB"
                                    Height="27"
                                    IsVisible="{Binding IsTransferring}">
                                </ProgressBar>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="1" Name="ips" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="10 0 0 0">
            <TextBlock Text="PC IP: " VerticalAlignment="Center"/>
            <TextBlock Name="pc" Width="150" VerticalAlignment="Center" Text="{Binding PcIP}"/>
            <TextBlock Text="PS4 IP: " VerticalAlignment="Center"/>
            <TextBox Name="ps4" MaxLength="15" Width="150" Text="{Binding Ps4IP}" PlaceholderText="192.168.0.xx"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Name="pkgCommands" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0 0 0 10">
            <Button Click="OnAddPKGClicked" Background="LightGreen">Add PKG</Button>
            <Button Command="{Binding ClearPKGsCommand}" Background="Red">Clear PKGs</Button>
            <Button Command="{Binding StartTransferCommand}" Background="Green">Send to PS4</Button>
        </StackPanel>
    </Grid>
</Window>